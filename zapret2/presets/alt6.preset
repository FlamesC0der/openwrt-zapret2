#@name: Alt6 - hostfakesplit
#@description: Fake host name between the real segments + MD5.
#@description.ru: Фейковое имя хоста между настоящими сегментами + MD5.
#@tcp_ports: 80,443
#@udp_ports: 443
--filter-tcp=80 --filter-l7=http <HOSTLIST> --payload=http_req --lua-desync=hostfakesplit:tcp_md5 --new
--filter-tcp=443 --filter-l7=tls <HOSTLIST> --payload=tls_client_hello --lua-desync=hostfakesplit:midhost=midsld:tcp_md5 --new
--filter-udp=443 --filter-l7=quic <HOSTLIST_NOAUTO> --payload=quic_initial --lua-desync=fake:blob=fake_default_quic:repeats=6
