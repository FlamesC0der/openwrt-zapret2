#@name: Alt5 - fakedsplit
#@description: Split with fake segments mixed between the real ones (fakedsplit) and an MD5 option so the server drops the fakes.
#@description.ru: Разрезание с замешиванием фейковых сегментов между настоящими (fakedsplit) и MD5-опцией, чтобы сервер отбросил фейки.
#@tcp_ports: 80,443
#@udp_ports: 443
--filter-tcp=80 --filter-l7=http <HOSTLIST> --payload=http_req --lua-desync=fakedsplit:pos=method+2:tcp_md5 --new
--filter-tcp=443 --filter-l7=tls <HOSTLIST> --payload=tls_client_hello --lua-desync=fakedsplit:pos=midsld:tcp_md5 --new
--filter-udp=443 --filter-l7=quic <HOSTLIST_NOAUTO> --payload=quic_initial --lua-desync=fake:blob=fake_default_quic:repeats=6
