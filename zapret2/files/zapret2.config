config zapret2 'main'
	# Master switch: start at boot and on "Save & Apply".
	option enabled '0'

	### Strategy ###############################################################
	# id of the active preset (Presets page): default, alt1, ... or your own
	option preset 'default'

	### General ################################################################
	# none | ipset | hostlist | autohostlist
	option mode_filter 'none'
	# networks treated as LAN (names from /etc/config/network)
	list lan 'lan'
	# donttouch | none | software | hardware
	option flowoffload 'donttouch'
	option disable_ipv6 '1'
	# empty = autodetect (nftables on OpenWrt >= 22.03 / iptables)
	option fwtype ''
	# nftables only: 1 = post-NAT (default), 0 = pre-NAT
	option postnat '1'
	option init_apply_fw '1'
	option filter_ttl_expired_icmp '1'

	### nfqws2 #################################################################
	option nfqws2_enable '0'
	# Ports and connbytes limits normally come from the preset header; set a value
	# here only to override them for every preset.
	option nfqws2_ports_tcp ''
	option nfqws2_ports_udp ''

	### Presets ################################################################
	# URLs with preset bundles (see README); downloaded presets are stored in
	# /etc/zapret2/presets/downloaded
	# list preset_url 'https://example.com/zapret2-presets.txt'
	option presets_auto_update '0'

	### Lists ##################################################################
	# script from /usr/share/zapret2/ipset that downloads lists, e.g.
	# get_refilter_domains.sh, get_antizapret_domains.sh, get_user.sh
	option getlist ''
	# hour (0-23) of the daily update of lists (and presets, if enabled);
	# empty = no automatic update
	option list_update_hour '6'
	option gzip_lists '1'

	### Updates ################################################################
	# once a day look for a new version of this package (the result goes to the system log)
	option update_check_daily '0'

	### Advanced ###############################################################
	# Raw lines appended to the generated zapret2 `config` (shell syntax), e.g.
	#   IPSET_OPT="hashsize 262144 maxelem 522288"
	option extra_config ''

# Your own lists, referenced from presets as <LIST:name> (= /etc/zapret2/lists/name.txt).
# With a url the list is downloaded by "Update lists" and by the daily update.
#
# config userlist 'general'
#	option title 'General'
#	option url 'https://example.com/list-general.txt'
