#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: MIT
#
# procd init script. Based on init.d/openwrt/zapret2 from bol-van/zapret2 (MIT),
# adapted to the packaged layout:
#   - settings come from UCI (/etc/config/zapret2) and the selected preset; the
#     upstream-style `config` is generated from them (see
#     /usr/libexec/zapret2/env.sh);
#   - firewall/ipset logic is NOT re-implemented: it is upstream's own
#     $ZAPRET_BASE/init.d/openwrt/functions;
#   - the `enabled` option of the UCI section controls start at boot / on config
#     change; `start`/`stop` commands always act immediately.

USE_PROCD=1
# after network
START=21

my_extra_command() {
	local cmd="$1"
	local help="$2"

	local extra="$(printf "%-16s%s" "${cmd}" "${help}")"
	EXTRA_HELP="${EXTRA_HELP}	${extra}
"
	EXTRA_COMMANDS="${EXTRA_COMMANDS} ${cmd}"
}
my_extra_command stop_fw "Stop zapret2 firewall (noop in iptables+fw3 case)"
my_extra_command start_fw "Start zapret2 firewall (noop in iptables+fw3 case)"
my_extra_command restart_fw "Restart zapret2 firewall (noop in iptables+fw3 case)"
my_extra_command reload_ifsets "Reload interface lists (nftables only)"
my_extra_command list_ifsets "Display interface lists (nftables only)"
my_extra_command list_table "Display zapret2 nftable (nftables only)"
my_extra_command stop_daemons "Stop nfqws2 only (=stop in iptables+fw3 case)"
my_extra_command start_daemons "Start nfqws2 only (=start in iptables+fw3 case)"
my_extra_command restart_daemons "Restart nfqws2 only (=restart in iptables+fw3 case)"
my_extra_command update_lists "Download/refresh ip/host lists now"
my_extra_command update_presets "Download presets from preset_url now"

. /usr/libexec/zapret2/env.sh
# (re)generate $ZAPRET_CONFIG from /etc/config/zapret2 and the preset if needed
zapret_prepare

# upstream: sources $ZAPRET_CONFIG, common/*.sh and defines firewall helpers
. "$ZAPRET_BASE/init.d/openwrt/functions"


# !!!!! on OpenWrt with fw3 + iptables firewall rules are applied from a firewall include
# !!!!! on OpenWrt with fw4 (nftables) firewall is configured here

PIDDIR=/var/run

USEROPT="--user=$WS_USER"
NFQWS2="${NFQWS2:-$ZAPRET_BASE/nfq2/nfqws2}"
LUAOPT="--lua-init=@$ZAPRET_BASE/lua/zapret-lib.lua --lua-init=@$ZAPRET_BASE/lua/zapret-antidpi.lua --lua-init=@$ZAPRET_BASE/lua/zapret-auto.lua"
NFQWS2_OPT_BASE="$USEROPT --fwmark=$DESYNC_MARK $LUAOPT"

run_daemon()
{
	# $1 - daemon string id or number. can use 1,2,3,...
	# $2 - daemon
	# $3 - daemon args
	# use $PIDDIR/$DAEMONBASE_$1.pid as pidfile
	local DAEMONBASE="$(basename "$2")"
	echo "Starting daemon $1: $2 $3"
	procd_open_instance
	procd_set_param command $2 $3
	procd_set_param pidfile $PIDDIR/${DAEMONBASE}_$1.pid
	# daemon output goes to syslog (logread -e zapret2)
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

run_nfqws()
{
	run_daemon $1 "$NFQWS2" "$NFQWS2_OPT_BASE $2"
}
do_nfqws()
{
	[ "$1" = 0 ] || { shift; run_nfqws "$@"; }
}

start_daemons_procd()
{
	standard_mode_daemons 1
	custom_runner zapret_custom_daemons 1

	return 0
}
start_daemons()
{
	rc_procd start_daemons_procd "$@"
}
stop_daemons()
{
	local svc="$(basename ${basescript:-$initscript})"
	procd_running "$svc" "$1" && procd_kill "$svc" "$1"
}
restart_daemons()
{
	stop_daemons
	start_daemons
}

start_fw()
{
	zapret_apply_firewall
}
stop_fw()
{
	zapret_unapply_firewall
}
restart_fw()
{
	stop_fw
	start_fw
}
reload_ifsets()
{
	zapret_reload_ifsets
}
list_ifsets()
{
	zapret_list_ifsets
}
list_table()
{
	zapret_list_table
}
update_lists()
{
	"$ZAPRET_LIBEXEC/job.sh" run update-lists
}
update_presets()
{
	"$ZAPRET_LIBEXEC/job.sh" run update-presets
}

# `start` at boot is conditional: only when enabled in UCI (LuCI "Enable zapret2")
boot()
{
	[ "$(uci -q get zapret2.main.enabled)" = 1 ] || return 0
	start "$@"
}

# nothing to start: nfqws2 is not enabled and there are no custom scripts
# (e.g. right after package installation, while all defaults are off)
zapret_nothing_to_do()
{
	[ "$NFQWS2_ENABLE" = 1 ] && return 1
	dir_is_not_empty "$CUSTOM_DIR/custom.d" && return 1
	return 0
}

start_service()
{
	zapret_nothing_to_do && {
		echo "zapret2: nfqws2 is not enabled, nothing to start"
		return 0
	}
	: >"$ZAPRET_STATE"
	start_daemons_procd
	[ "$INIT_APPLY_FW" != "1" ] || {
		linux_fwtype
		if openwrt_fw3_integration; then
			zapret_fw3_sync add
		else
			start_fw
		fi
	}
	zapret_cron_sync sync
}

stop_service()
{
	# this procedure is called from stop()
	# stop() already stop daemons
	rm -f "$ZAPRET_STATE"
	zapret_cron_sync off
	[ "$INIT_APPLY_FW" != "1" ] || {
		linux_fwtype
		if openwrt_fw3_integration; then
			zapret_fw3_sync del
		else
			stop_fw
		fi
	}
}

service_triggers()
{
	# apply on `uci commit zapret2` / LuCI "Save & Apply"
	procd_add_reload_trigger zapret2
}

reload_service()
{
	if [ "$(uci -q get zapret2.main.enabled)" = 1 ]; then
		stop
		start
	else
		stop
	fi
}
