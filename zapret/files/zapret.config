config zapret 'main'
	# Master switch: start at boot and on "Save & Apply".
	option enabled '0'

	### General ################################################################
	# none | ipset | hostlist | autohostlist
	option mode_filter 'none'
	# networks treated as LAN (names from /etc/config/network)
	list lan 'lan'
	# donttouch | none | software | hardware
	option flowoffload 'donttouch'
	option disable_ipv6 '1'
	# empty = autodetect (nftables on OpenWrt >= 22.03 / iptables)
	option fwtype ''
	# nftables only: 1 = post-NAT (default), 0 = pre-NAT
	option postnat '1'
	option init_apply_fw '1'
	option filter_ttl_expired_icmp '1'

	### nfqws ##################################################################
	option nfqws_enable '0'
	option nfqws_ports_tcp '80,443'
	option nfqws_ports_udp '443'
	option nfqws_opt '--filter-tcp=80 --dpi-desync=fake,multisplit --dpi-desync-split-pos=method+2 --dpi-desync-fooling=md5sig <HOSTLIST> --new
--filter-tcp=443 --dpi-desync=fake,multidisorder --dpi-desync-split-pos=1,midsld --dpi-desync-fooling=badseq,md5sig <HOSTLIST> --new
--filter-udp=443 --dpi-desync=fake --dpi-desync-repeats=6 <HOSTLIST_NOAUTO>'

	### tpws ###################################################################
	option tpws_enable '0'
	option tpws_ports '80,443'
	option tpws_opt '--filter-tcp=80 --methodeol <HOSTLIST> --new
--filter-tcp=443 --split-pos=1,midsld --disorder <HOSTLIST>'
	option tpws_socks_enable '0'
	option tpport_socks '987'
	option tpws_socks_opt '--filter-tcp=80 --methodeol <HOSTLIST> --new
--filter-tcp=443 --split-pos=1,midsld --disorder <HOSTLIST>'

	### Lists ##################################################################
	# script from /usr/share/zapret/ipset that downloads lists, e.g.
	# get_refilter_domains.sh, get_antizapret_domains.sh, get_user.sh
	option getlist ''
	# hour (0-23) of the daily list update; empty = no automatic update
	option list_update_hour '6'
	option gzip_lists '1'

	### Advanced ###############################################################
	# Raw lines appended to the generated zapret `config` (shell syntax), e.g.
	#   IPSET_OPT="hashsize 262144 maxelem 522288"
	option extra_config ''
